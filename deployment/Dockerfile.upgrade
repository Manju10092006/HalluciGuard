# Reuse the account's immutable CPU runtime with four pinned models baked in.
# This avoids downloading multi-GB model weights on a cold HTTP request.
ARG MODEL_RUNTIME
FROM ${MODEL_RUNTIME}
WORKDIR /app
RUN pip install --no-cache-dir 'fastapi==0.162.2' 'starlette==1.10.0' 'google-cloud-firestore>=2.34.1,<3.0.0' 'pyarrow==23.0.1'
COPY orchestration /app/orchestration
COPY services /app/services
COPY agents /app/agents
COPY halluciguard_detector /app/halluciguard_detector
COPY halluciguard_judge /app/halluciguard_judge
COPY deployment/container_smoke.py /app/deployment/container_smoke.py
ENV HALLUCIGUARD_ENV=production HALLUCIGUARD_LLM_PROVIDER_ORDER=openrouter \
    OPENROUTER_MODEL=openrouter/free HG_CORRECTOR_PROVIDER=openrouter \
    HG_CORRECTOR_OPENROUTER_MODEL=openrouter/free \
    MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2 \
    ALWAYS_VERIFY=true ALLOW_DETECTOR_FAST_PATH=false N8N_RETRIEVAL_ENABLED=false \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ALLOW_MODEL_DOWNLOADS=false
RUN python /app/deployment/container_smoke.py
EXPOSE 8080
CMD exec uvicorn orchestration.api:app --host 0.0.0.0 --port ${PORT:-8080}
