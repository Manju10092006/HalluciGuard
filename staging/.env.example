# HalluciGuard Detector Staging Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and configure as needed for staging.
# NEVER commit real tokens, secrets, or API keys to version control.
# ─────────────────────────────────────────────────────────────

# Hugging Face model repository identifier (or local artifact directory)
HALUEVAL_MODEL_PATH=Manjunath2000006/halluciguard-detector

# Tokenizer maximum sequence length
HALUEVAL_MAX_LENGTH=384

# Optional: Hugging Face access token (only required for gated/private repositories)
# HF_TOKEN=your_huggingface_token_here

# Staging Server Configuration
HOST=0.0.0.0
PORT=8000
