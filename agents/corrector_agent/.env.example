# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Production hosted Corrector (RARR-inspired evidence-bound revision)
# Leave GROQ_API_KEY unset to use the legacy local Corrector path.
HG_CORRECTOR_PROVIDER=groq
GROQ_API_KEY=
HG_CORRECTOR_GROQ_MODEL=openai/gpt-oss-120b
HG_CORRECTOR_GROQ_REASONING_EFFORT=low
HG_CORRECTOR_GROQ_MAX_RETRIES=2
HG_CORRECTOR_GROQ_TIMEOUT_SECONDS=45
