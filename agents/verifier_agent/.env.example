# Optional API Keys (system works without these on free tiers)
ALPHA_VANTAGE_KEY=
OPENFDA_KEY=
NVD_API_KEY=

# Mock mode for offline development and CI tests
MOCK_MODE=false

# Model settings
NLI_MODEL=microsoft/deberta-v3-base-mnli
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cache TTL in seconds (default 24 hours)
CACHE_TTL=86400

# Server
VERIFIER_PORT=8002
LOG_LEVEL=INFO
