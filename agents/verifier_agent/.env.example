# =============================================================================
# HalluciGuard Verifier Agent — Environment Configuration
# =============================================================================

# -- Optional API Keys (system works without these on free tiers) --
ALPHA_VANTAGE_KEY=
OPENFDA_KEY=
NVD_API_KEY=
SEMANTIC_SCHOLAR_KEY=
COURTLISTENER_KEY=
SEC_USER_AGENT=HalluciGuard/2.0 compliance@halluciguard.ai

# -- Feature Flags --
MOCK_MODE=false
ALLOW_MODEL_DOWNLOADS=false
ENABLE_DOMAIN_CLASSIFIER=false
ENABLE_CONFIDENCE_CALIBRATION=true

# -- Model Selections --
NLI_MODEL=cross-encoder/nli-deberta-v3-base
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_MODEL=BAAI/bge-m3
ZERO_SHOT_MODEL=facebook/bart-large-mnli

# -- Model Runtime --
MAX_CACHED_MODELS=8
GPU_MEMORY_THRESHOLD_MB=512
DEFAULT_LATENCY_BUDGET=balanced

# -- Cache TTL in seconds (default 24 hours) --
CACHE_TTL=86400

# -- Server --
VERIFIER_PORT=8002
LOG_LEVEL=INFO
