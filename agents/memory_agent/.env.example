MEMORY_AGENT_PORT=8005
MOCK_MODE=false

# Knowledge Graph
KG_PERSISTENCE_PATH=data/knowledge_graph.json
KG_MAX_NODES=100000
KG_EDGE_WEIGHT_DECAY=0.95

# Verification Cache
CACHE_DB_PATH=data/verification_cache.db
CACHE_TTL=86400

# Vector Store
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/vector_store
VECTOR_DIMENSION=384
VECTOR_TOP_K=10

# Pattern Learning
PATTERN_DB_PATH=data/patterns.db
PATTERN_MIN_SUPPORT=3
PATTERN_CONFIDENCE_THRESHOLD=0.6

# Source Trust
TRUST_DB_PATH=data/source_trust.db
TRUST_PRIOR=0.5
TRUST_LEARNING_RATE=0.1
TRUST_DECAY_RATE=0.01
