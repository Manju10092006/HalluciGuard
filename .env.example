# HalluciGuard runtime configuration

# Required for real Detector execution.
# Local directory produced by:
#   python -m agents.detector_agent.halueval_trainer --output-dir artifacts/halueval-detector-final
# The directory must contain config.json, tokenizer files, and model.safetensors or pytorch_model.bin.
# You may also set this to hf://ORG/MODEL for a Hugging Face Hub repo containing the fine-tuned detector artifact.
HALUEVAL_MODEL_PATH=artifacts/halueval-detector-final
HALUEVAL_MAX_LENGTH=384

# Optional: training/download configuration for creating the detector artifact.
HALUEVAL_BASE_MODEL=distilbert-base-uncased
HALUEVAL_OUTPUT_DIR=artifacts/halueval-detector-final

# Verifier/Judge model configuration. Set TRANSFORMERS_OFFLINE=1 only when all models are cached locally.
# TRANSFORMERS_OFFLINE=0
# HF_HOME=.cache/huggingface

# Orchestration retry bound.
HALLUCIGUARD_MAX_VERIFICATION_RETRIES=2

# Optional external API keys used by real verifier adapters.
# SEMANTIC_SCHOLAR_KEY=
