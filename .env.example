# ==============================================================================
# HalluciGuard Environment Configuration Template
# ==============================================================================

# Application Environment
HALLUCIGUARD_ENV=production
HALLUCIGUARD_MAX_VERIFICATION_RETRIES=2

# ------------------------------------------------------------------------------
# Multi-Provider LLM Router (server-side ONLY; never expose keys in frontend)
# Failover order is tried left-to-right. Providers without a key are skipped.
# ------------------------------------------------------------------------------
HALLUCIGUARD_LLM_PROVIDER_ORDER=groq,gemini,openrouter

# Groq (PRIMARY) - OpenAI-compatible API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (FALLBACK) - Google AI Studio OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter (LAST FALLBACK)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-14b

# Shared generation tuning (applies across all providers)
HALLUCIGUARD_LLM_MODEL=qwen/qwen3-14b
HALLUCIGUARD_LLM_TEMPERATURE=0.7
HALLUCIGUARD_LLM_TIMEOUT=30
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_STRESS_TEMPERATURE=0.9
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=3
OPENROUTER_X_TITLE=HalluciGuard

# Detector Model Configuration
HALUEVAL_MODEL_PATH=artifacts/halueval-detector-final
HALUEVAL_MAX_LENGTH=384
ALWAYS_VERIFY=true
ALLOW_DETECTOR_FAST_PATH=false

# Verifier NLI & Retrieval Model Configuration
ALLOW_MODEL_DOWNLOADS=true
NLI_MODEL=cross-encoder/nli-deberta-v3-base
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_MODEL=BAAI/bge-m3

# Corrector uses the same multi-provider LLM router by default (Groq->Gemini->OpenRouter).
# HG_CORRECTOR_PROVIDER stays as the local-vs-remote switch: "local" uses the
# on-disk Qwen LoRA corrector; anything else uses the hosted multi-provider router.
HG_CORRECTOR_PROVIDER=openrouter
# Optional per-provider correction-model pins (fall back to the global *_MODEL):
HG_CORRECTOR_OPENROUTER_MODEL=qwen/qwen3-14b
HG_CORRECTOR_GROQ_MODEL=
HG_CORRECTOR_GEMINI_MODEL=

# Web Evidence Retrieval (Tavily)
TAVILY_API_KEY=

# NVD Cybersecurity API
NVD_API_KEY=

# Cache Control (set false during development/debugging)
CACHE_ENABLED=true

# n8n Retrieval Service V2 Configuration
N8N_RETRIEVAL_ENABLED=false
N8N_RETRIEVAL_WEBHOOK_URL=https://guru-siesta-excusable.ngrok-free.dev/webhook/halluciguard-verify-v2
N8N_HEALTH_WEBHOOK_URL=https://guru-siesta-excusable.ngrok-free.dev/healthz
N8N_AUTH_MODE=header
N8N_HEADER_NAME=X-API-Key
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=60

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=

# Authentication (required in production)
JWT_SECRET=
GOOGLE_CLIENT_ID=
AUTH_DB_PATH=data/halluciguard_users.db
