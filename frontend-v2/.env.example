# ==============================================================================
# HalluciGuard Frontend — Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development, and set the same keys
# in your Vercel Project Settings → Environment Variables for deployment.
#
# SECURITY: Every variable here is prefixed NEXT_PUBLIC_ and is therefore shipped
# to the browser. NEVER put a secret here. Backend-only secrets (OpenRouter key,
# Tavily key, NVD key, n8n webhook secret, and any Google OAuth *client secret*)
# must live server-side on the backend, never in this frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API
# ------------------------------------------------------------------------------
# Base URL of the HalluciGuard verification engine (FastAPI).
# Exposes POST /verify and GET /health. No trailing slash.
# Local backend example:   http://localhost:8000
# Deployed backend example: https://your-backend-host
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Request timeout for a verification call, in milliseconds.
# Verification runs multiple models + retrieval, so keep this generous.
NEXT_PUBLIC_API_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# Google OAuth (Google Identity Services — client-only)
# ------------------------------------------------------------------------------
# The OAuth 2.0 **Client ID** for a "Web application" credential.
# This value is public by design in the Google Identity Services browser flow.
# The matching client *secret* is NOT used here and must never be added.
#
# In Google Cloud Console → Credentials → your Web client, add every origin you
# deploy from to "Authorized JavaScript origins":
#   http://localhost:3000
#   https://<your-vercel-preview>.vercel.app
#   https://<your-production-domain>
# Sign-in is disabled gracefully if this is left blank (anonymous use still works).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Development toggles
# ------------------------------------------------------------------------------
# When "true", the app uses a local mock verification adapter instead of calling
# the backend. Intended ONLY for local UI development without a running backend.
# Leave "false" (or unset) for any real/deployed environment.
NEXT_PUBLIC_ENABLE_MOCK=false
