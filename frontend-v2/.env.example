# Next.js server-side backend origin (never include an /api suffix).
# Local development:
BACKEND_URL=http://localhost:8000
# Vercel production: set BACKEND_URL to the verified Google Cloud Run URL.

# Browser requests always use /api/backend. Old NEXT_PUBLIC_API_BASE_URL is ignored.
NEXT_PUBLIC_API_TIMEOUT_MS=290000

# Public Google OAuth web client ID; match GOOGLE_CLIENT_ID on the backend.
# Leave blank to offer email/password authentication only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
